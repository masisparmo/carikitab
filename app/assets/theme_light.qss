/* Light Theme */
QMainWindow {
    background-color: #f4f6f9;
}

QWidget {
    font-family: "Segoe UI", "Inter", sans-serif;
    color: #333333;
}

QLineEdit, QComboBox {
    background-color: #ffffff;
    border: 1px solid #ced4da;
    border-radius: 8px;
    padding: 8px 12px;
    font-size: 14px;
}

QLineEdit:focus, QComboBox:focus {
    border: 2px solid #0056b3;
    outline: none;
}

QPushButton {
    background-color: #0d6efd;
    color: #ffffff;
    border: none;
    border-radius: 8px;
    padding: 8px 16px;
    font-size: 14px;
    font-weight: bold;
}

QPushButton:hover {
    background-color: #0b5ed7;
}

QPushButton:pressed {
    background-color: #0a58ca;
}

/* Secondary Button */
QPushButton#btnSecondary {
    background-color: #f8f9fa;
    color: #212529;
    border: 1px solid #ced4da;
}

QPushButton#btnSecondary:hover {
    background-color: #e2e6ea;
}

/* Card Style */
QFrame#resultCard {
    background-color: #ffffff;
    border: 1px solid #e9ecef;
    border-radius: 12px;
    /* Since QSS doesn't support complex drop shadows well directly, we use soft borders */
}

/* Progress Bar */
QProgressBar {
    background-color: #e9ecef;
    border: none;
    border-radius: 6px;
    text-align: center;
    color: #495057;
    height: 12px;
}

QProgressBar::chunk {
    background-color: qlineargradient(x1: 0, y1: 0, x2: 1, y2: 0,
                                      stop: 0 #0d6efd, stop: 1 #00b09b);
    border-radius: 6px;
}

/* Tabs */
QTabWidget::pane {
    border: 1px solid #dee2e6;
    background: #ffffff;
    border-radius: 8px;
}

QTabBar::tab {
    background: #e9ecef;
    border: 1px solid #dee2e6;
    padding: 8px 20px;
    border-top-left-radius: 8px;
    border-top-right-radius: 8px;
    margin-right: 2px;
}

QTabBar::tab:selected {
    background: #ffffff;
    border-bottom-color: #ffffff;
    font-weight: bold;
    color: #0d6efd;
}

/* Scrollbar */
QScrollBar:vertical {
    background: #f8f9fa;
    width: 12px;
    margin: 0px 0px 0px 0px;
}

QScrollBar::handle:vertical {
    background: #ced4da;
    min-height: 20px;
    border-radius: 6px;
}

QScrollBar::handle:vertical:hover {
    background: #adb5bd;
}

QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical {
    height: 0px;
}

/* Chat & List Widgets */
QTextBrowser, QTextEdit, QListWidget {
    background-color: #ffffff;
    color: #333333;
    border: 1px solid #dee2e6;
    border-radius: 8px;
}

QListWidget::item {
    padding: 10px;
    border-bottom: 1px solid #f1f3f5;
    color: #495057;
}

QListWidget::item:selected {
    background-color: #e9ecef;
    color: #0d6efd;
    font-weight: bold;
}

#sidebarWidget {
    background-color: #f8f9fa;
    border-right: 1px solid #dee2e6;
}
